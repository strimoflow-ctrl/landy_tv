
# Server Port (Railway automatically sets PORT)
PORT=5000

# Security Key
API_SECRET_KEY=landyxcryvexsidhu5911

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Public WebApp URL (Railway provided HTTPS URL)
WEB_APP_URL=https://your-app-name.up.railway.app

# Internet Archive (Archive.org) S3 API Keys (from https://archive.org/account/s3.php)
ARCHIVE_ACCESS_KEY=your_archive_access_key
ARCHIVE_SECRET_KEY=your_archive_secret_key

# PDF Automation Cycle Interval in Hours (Default: 3)
PDF_INTERVAL_HOURS=3